rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function member(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function role(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.role;
    }

    function editor(householdId) {
      return member(householdId) && (role(householdId) == 'admin' || role(householdId) == 'editor');
    }

    function owner(householdId) {
      return signedIn()
        && get(/databases/$(database)/documents/households/$(householdId)).data.ownerUid == request.auth.uid;
    }

    // Access to each workspace is assigned by the household owner.
    // The owner always has access to both workspaces.
    function canAccessWorkspace(householdId, workspaceId) {
      return owner(householdId)
        || (
          member(householdId)
          && get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.workspaces is list
          && get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.workspaces.hasAny([workspaceId])
        );
    }

    function ownerLegacy(householdId) {
      return owner(householdId);
    }

    function appOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/households/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId)).data.ownerUid == request.auth.uid;
    }

    function invitedMember(householdId) {
      return signedIn()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.role == 'member'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.inviteCode is string
        && exists(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode)).data.householdId == householdId
        && get(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode)).data.expiresAt > request.time;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'member'
        && request.resource.data.householdId is string
        && request.resource.data.keys().hasAll(['householdId', 'role', 'email', 'displayName', 'inviteCode'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['householdId', 'role', 'email', 'displayName', 'inviteCode', 'createdAt', 'updatedAt'])
        && exists(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode)).data.householdId == request.resource.data.householdId;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == request.auth.token.email;

      allow delete: if false;
    }

    match /households/{householdId} {
      allow get, list: if member(householdId);
      allow create: if false;
      allow update: if owner(householdId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if owner(householdId);

      match /members/{memberId} {
        allow read: if member(householdId);
        allow create: if owner(householdId) || invitedMember(householdId);
        allow update: if owner(householdId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['workspaces', 'updatedAt'])
          && request.resource.data.workspaces is list
          && request.resource.data.workspaces.hasOnly(['home', 'sandwichies']);
        allow delete: if owner(householdId);
      }

      // Final household inventory boundary.
      // Product identity remains in productCatalog/{barcode}.
      match /inventory/{barcode} {
        allow read: if canAccessWorkspace(householdId, "home");
        allow create, update, delete: if canAccessWorkspace(householdId, "home") && editor(householdId);
      }

      match /movements/{movementId} {
        allow read: if canAccessWorkspace(householdId, "home");
        allow create: if canAccessWorkspace(householdId, "home") && editor(householdId);
        allow update, delete: if owner(householdId);
      }

      match /shoppingItems/{itemId} {
        allow read: if canAccessWorkspace(householdId, "home");
        allow create, update, delete: if canAccessWorkspace(householdId, "home") && editor(householdId);
      }

      match /recipes/{recipeId} {
        allow read: if canAccessWorkspace(householdId, "home");
        allow create, update, delete: if canAccessWorkspace(householdId, "home") && editor(householdId);
      }

      match /expiryRules/{ruleId} {
        allow read: if canAccessWorkspace(householdId, "home");
        allow create, update, delete: if canAccessWorkspace(householdId, "home") && editor(householdId);
      }

      match /settings/{settingId} {
        allow read: if canAccessWorkspace(householdId, "home");
        allow create, update, delete: if owner(householdId);
      }

      // Business inventory is isolated from the legacy household inventory.
      // Household membership grants visibility, but only the household owner
      // may change Sandwichies business data. UI workspace selection is not authorization.
      match /workspaces/{workspaceId}/{document=**} {
        allow read: if workspaceId == "sandwichies"
          && canAccessWorkspace(householdId, "sandwichies");
        allow create, update, delete: if workspaceId == "sandwichies"
          && owner(householdId);
      }
    }

    match /productCatalog/{barcode} {
      allow read: if signedIn();

      // The shared catalog is managed only by the verified app/household owner.
      // Household guests can read products but cannot add catalog entries.
      allow create: if appOwner()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.keys().hasAll(['name', 'createdBy', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly([
          'name',
          'description',
          'brand',
          'weight',
          'imageUrl',
          'category',
          'createdBy',
          'createdAt',
          'updatedAt'
        ]);

      // Existing products remain intact; only the app/household owner may edit them.
      allow update: if appOwner()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'description',
          'brand',
          'weight',
          'imageUrl',
          'category',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /householdInvites/{inviteCode} {
      allow read: if signedIn();
      allow create: if owner(request.resource.data.householdId)
        && request.resource.data.role == 'member'
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if owner(resource.data.householdId);
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
