rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function member(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    function role(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid)).data.role;
    }

    function editor(householdId) {
      return member(householdId) && (role(householdId) == 'admin' || role(householdId) == 'editor');
    }

    function owner(householdId) {
      return signedIn()
        && get(/databases/$(database)/documents/households/$(householdId)).data.ownerUid == request.auth.uid;
    }

    function invitedMember(householdId) {
      return signedIn()
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.role == 'member'
        && request.resource.data.inviteCode is string
        && exists(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode)).data.householdId == householdId;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'member'
        && request.resource.data.householdId is string
        && request.resource.data.keys().hasAll(['householdId', 'role', 'email', 'displayName'])
        && request.resource.data.keys().hasOnly(['householdId', 'role', 'email', 'displayName', 'inviteCode', 'createdAt', 'updatedAt'])
        && exists(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/householdInvites/$(request.resource.data.inviteCode)).data.householdId == request.resource.data.householdId;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])
        && request.resource.data.householdId == resource.data.householdId
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    match /households/{householdId} {
      allow get, list: if member(householdId);
      allow create: if false;
      allow update: if owner(householdId)
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if owner(householdId);

      match /members/{memberId} {
        allow read: if member(householdId);
        allow create: if owner(householdId) || invitedMember(householdId);
        allow update: if owner(householdId)
          && request.resource.data.role != 'admin';
        allow delete: if owner(householdId);
      }

      match /products/{productId} {
        allow read: if member(householdId);
        allow create, update, delete: if editor(householdId);
      }

      match /movements/{movementId} {
        allow read: if member(householdId);
        allow create: if editor(householdId);
        allow update, delete: if owner(householdId);
      }

      match /shoppingItems/{itemId} {
        allow read: if member(householdId);
        allow create, update, delete: if editor(householdId);
      }

      match /recipes/{recipeId} {
        allow read: if member(householdId);
        allow create, update, delete: if editor(householdId);
      }

      match /expiryRules/{ruleId} {
        allow read: if member(householdId);
        allow create, update, delete: if editor(householdId);
      }

      match /settings/{settingId} {
        allow read: if member(householdId);
        allow create, update, delete: if owner(householdId);
      }
    }

    match /householdInvites/{inviteCode} {
      allow read: if signedIn();
      allow create: if owner(request.resource.data.householdId)
        && request.resource.data.role == 'member'
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if owner(resource.data.householdId);
      allow update: if false;
    }

    // Legacy inventory is no longer writable by clients.
    // Existing data should be migrated into households/{householdId}/products.
    match /products/{productId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
